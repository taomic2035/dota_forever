{
  "name": "dota-forever",
  "private": true,
  "version": "2.1.0",
  "description": "浏览器端经典 DotA 1 玩法复刻——单机 vs AI 的 5v5 三路推塔 MOBA。TypeScript;2D(Canvas2D)与可选真 3D(Three.js)双渲染器,全原创内容(机制复刻,非版权素材)。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "batchsim": "vitest run -c vitest.batch.config.ts"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
